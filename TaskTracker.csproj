<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TaskTracker</AssemblyName>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- No culture-specific formatting is used server-side; skipping ICU loading speeds up boot. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="public/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Local runtime data must never ship in the app package. -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
    <!-- Leftover from the old Node.js version of this project; unused by the .NET app. -->
    <Content Remove="package-lock.json" />
    <None Remove="package-lock.json" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <!-- A single bundled exe must self-extract on every launch, which is much slower than loading files already on disk. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Precompiled native code speeds up cold start of the self-contained desktop build. -->
    <PublishReadyToRun Condition="'$(SelfContained)' == 'true'">true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>
  <!-- The WebView2 package always adds a WPF reference, which conflicts with the WinForms WindowsBase version; we only use WinForms. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <!-- createdump.exe (crash-dump helper) and .xml doc comments aren't needed to run the app; drop them to declutter the publish folder. -->
  <Target Name="RemoveUnneededPublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <FilesToCleanUp Include="$(PublishDir)createdump*" />
      <FilesToCleanUp Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(FilesToCleanUp)" />
  </Target>
</Project>