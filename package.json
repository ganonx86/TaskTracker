{
  "name": "tasktracker",
  "version": "1.0.0",
  "description": "CLI pour gerer des taches, sous-taches et deadlines",
  "type": "module",
  "bin": {
    "tasktracker": "./bin/tasktracker.js"
  },
  "scripts": {
    "start": "node bin/tasktracker.js",
    "build:windows": "pkg --no-bytecode --public --targets node20-win-x64 --output dist/TaskTracker.exe bin/tasktracker.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  },
  "pkg": {
    "scripts": [
      "bin/**/*.js",
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*"
    ]
  }
}
